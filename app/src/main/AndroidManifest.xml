<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Schnittstelle für eigene Apps (Chip-Widget, später Quälgeist), siehe INTEROP.md: nur Apps
         mit demselben Signaturschlüssel. Name mit applicationId, damit die anders signierte
         Debug-App keinen Installationskonflikt auslöst. -->
    <permission
        android:name="${applicationId}.permission.INTEROP"
        android:label="FH Stempelkarte: Status lesen und stempeln"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.INTEROP" />

    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <queries>
        <!-- Auswahl der ZEUS-App aus allen installierten Apps mit Startsymbol. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Empfänger des Zustands-Broadcasts (InteropContract.CONSUMERS). -->
        <package android:name="de.blaintino.chip" />
        <package android:name="de.quaelgeist" />
        <package android:name="de.quaelgeist.beta" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:theme="@style/Theme.Stempelkarte">

        <!-- Einstellungen; erreichbar über „Einstellungen“ im Auswahl-Dialog. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Startpunkt: Anmelden/Abmelden-Auswahl beim App-Start und aus der Meldung, dann ZEUS. -->
        <activity
            android:name=".ZeusActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity="de.fhstempelkarte.zeus"
            android:theme="@style/Theme.Stempelkarte.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Aktionen für eigene Apps (Chip-Widget): Einloggen/Ausloggen/Auswahl, danach ZEUS.
             Eigene Alias mit Berechtigung, damit ZeusActivity (Launcher, offen) die Direkt-
             Aktionen nur über diesen Weg annimmt (Interop.directFromExtern prüft den Namen). -->
        <activity-alias
            android:name=".ExternZeus"
            android:exported="true"
            android:permission="${applicationId}.permission.INTEROP"
            android:targetActivity=".ZeusActivity">
            <intent-filter>
                <action android:name="de.fhstempelkarte.action.EINLOGGEN" />
                <action android:name="de.fhstempelkarte.action.AUSLOGGEN" />
                <action android:name="de.fhstempelkarte.action.AUSWAHL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Nur lesbarer Status für eigene Apps (eine Zeile, siehe InteropContract). -->
        <provider
            android:name=".StatusProvider"
            android:authorities="${applicationId}.status"
            android:exported="true"
            android:readPermission="${applicationId}.permission.INTEROP"
            android:writePermission="${applicationId}.permission.INTEROP" />

        <!-- Startbildschirm-Widget: Zustand + Einloggen/Ausloggen. -->
        <receiver
            android:name=".StempelWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_stempel_info" />
        </receiver>

        <receiver
            android:name=".WindowReceiver"
            android:exported="false" />

        <receiver
            android:name=".DetectReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
